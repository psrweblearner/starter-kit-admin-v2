# server configuration
NODE_ENV=development
PORT=4000
DEBUG=false

# session secret
JWT_PUBLIC_KEY_PATH=./config/public.pem

# file upload path
UPLOAD_PATH=./uploads

# Server-side HTTP calls (auth refresh, FetchData). Local dev: API on same machine.
# Production on admin EC2 with nginx reverse proxy to API: use loopback through nginx
#   API_URL=http://127.0.0.1/v1/
# Or call API directly (private IP or https://api.example.com/v1/) if you prefer.
API_URL=http://localhost:5000/v1/

# Shared secret for internal server-to-server auth bypass
INTERNAL_SECRET=replace-with-a-long-random-string

# AWS credentials and region
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
