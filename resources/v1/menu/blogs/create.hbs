
<div class="psr-card">
    <div class="psr-card-header">
        <h3 class="psr-card-title">Add New Blog</h3>
    </div>
    <div class="psr-card-body">
        <div class="psr-tabs" data-psr-tabs>
            <div class="psr-tablist" role="tablist" aria-label="Blog Edit Tabs">
                <button role="tab" class="psr-tab active" aria-selected="true" aria-controls="tab-panel-1" id="tab-1">General</button>
            </div>
            
            <!-- General Tab -->
            <div tabindex="0" role="tabpanel" class="psr-tab-panel active" id="tab-panel-1" aria-labelledby="tab-1">
                <form id="blogEditForm" class="psr-form" autocomplete="off">
                    <div class="psr-form-group">
                        <label class="psr-form-label">Feature Image</label>
                        <div class="psr-field-with-published">
                            <div class="feature-image-preview" data-trigger-id="feature-image">
                                <div class="add-new-file-box rectangle" accept="image/*" data-file-picker="true"
                                    data-max-files="1" data-trigger-id="feature-image" data-preview-style="rectangle"
                                     access="{{user.access}}">
                                    <i class="fas fa-camera"></i>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="feature-image" name="file_id">
                    </div>
                    <div class="psr-grid psr-grid-col-3 gap-2">
                        <div class="psr-form-group">
                            <label class="psr-form-label">Blog Title *</label>
                            <div class="psr-field-with-published">
                                <input type="text" class="psr-form-input" id="title" name="title">
                            </div>
                        </div>
                        
                        <div class="psr-form-group">
                            <label class="psr-form-label">Slug *</label>
                            <div class="psr-field-with-published">
                                <input type="text" class="psr-form-input" id="slug" name="slug">
                            </div>
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Author *</label>
                            <div class="psr-field-with-published">
                                <select class="psr-form-input" id="author" name="author"
                                        data-url="admin" 
                                        data-root="data"
                                        data-label-field="firstName" 
                                        data-description-field="lastName" 
                                        data-value-field="id"
                                        data-placeholder="Select Author"
                                        data-single-select="true"
                                        data-concat-fields="firstName,lastName">
                                    <option value="">Select Author</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="psr-grid psr-grid-col-2 gap-2">
                        <div class="psr-form-group">
                            <label class="psr-form-label">Categories *</label>
                            <div class="psr-field-with-published">
                                <select class="psr-form-input" id="categories" name="categories" multiple
                                        data-url="categories" 
                                        data-root="data"
                                        data-value-field="id" 
                                        data-label-field="name" 
                                        data-description-field="description"
                                        data-placeholder="Select Categories">
                                </select>
                            </div>
                        </div>
                        
                        <div class="psr-form-group">
                            <label class="psr-form-label">Tags *</label>
                            <div class="psr-field-with-published">
                                <select class="psr-form-input" id="tags" name="tags" multiple
                                        data-url="tags" 
                                        data-root="data"
                                        data-value-field="id" 
                                        data-label-field="name" 
                                        data-description-field="description"
                                        data-placeholder="Select Tags">
                                </select>
                            </div>
                        </div>
                    </div>
                     <div class="psr-form-group">
                        <label class="psr-form-label">Tagline *</label>
                        <div class="psr-field-with-published">
                            <textarea class="psr-form-input psr-form-textarea" id="tagline" name="tagline" rows="3" placeholder="Short description or tagline"></textarea>
                        </div>
                    </div>
                    <div class="psr-form-group">
                        <label class="psr-form-label">Description *</label>
                        <div class="psr-field-with-published">
                            <textarea class="psr-form-input psr-form-textarea" type="editor" accept="*" id="description" name="description" rows="3" placeholder="description" data-tools="paragraph,header,list,image,video,link,table" ></textarea>
                        </div>
                    </div>
                    
                    <div class="psr-form-actions">
                        <button type="submit" class="psr-btn psr-btn-primary">
                            <i class="fa-solid fa-save"></i> Save Blog
                        </button>
                    </div>
                </form>
            </div>
            
        </div>
    </div>
</div>
{{#section 'script'}}
<script>
    $('#author,#tags,#categories').PSRMultiselect();
    $('#blogEditForm').psrValidate({
        rules: {
            title: { required: true, minLength: 2 },
            slug: { required: true, minLength: 2 },
            author: { required: true},
            categories:{ required: true},
            tags:{required:true},
            tagline:{required:true,minLength:10},
            description:{required:true,minLength:20},
            file_id: { required: true}
        },
        messages: {
            title: { required: 'Please enter title', minLength: 'Title should be more then 2 characters' },
            slug: { required: 'Please enter slug', minLength: 'Slug should be more then 2 characters' },
            author: { required: 'Please select author'},
            categories:{ required: 'Please select categories'},
            tags:{required:'Please select tags'},
            tagline:{required:'Please enter tagline',minLength:'Tagline must be at least 10 characters long'},
            description:{required:'Please enter description',minLength:'Description must be at least 20 characters long'},
            file_id: { required: 'Please select feature image' }
        },
        beforeSubmit: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', true);
            if (!$btn.find('.psr-spinner').length) {
                $btn.prepend('<span class="psr-spinner"></span> ');
            }
        },
        onValid: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $.ajax({
                url: api(`blogs`),   // change this
                method: 'POST',
                data: $form.serialize(),
                success: function (res) {
                    $form[0].reset();
                    toastr.success('Form submitted successfully!');
                    $form.find('.success, .error').removeClass('success error');
                    $form.find('.psr-field-error').remove();
                },
                error: function (err) {
                    toastr.error('An error occurred while submiting.' + err.message);
                },
                complete: function () {
                    // 🔹 always reset button
                    $btn.prop('disabled', false);
                    $btn.find('.psr-spinner').remove();
                }
            });

            return false;
        },
        onInvalid: function () {
            toastr.error('Please correct the errors in the form.');
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', false);
            $btn.find('.psr-spinner').remove();
        }
    });
</script>
{{/section}}