<div class="psr-card">
    <div class="psr-card-header">
        <h3 class="psr-card-title">Add New User</h3>
    </div>
    <div class="psr-card-body">
        <div class="psr-tabs" data-psr-tabs>
            <div class="psr-tablist" role="tablist" aria-label="Sample Tabs">
                <button role="tab" class="psr-tab active" aria-selected="true" aria-controls="tab-panel-1"
                    id="tab-1">Home</button>
            </div>
            <div tabindex="0" role="tabpanel" class="psr-tab-panel active" id="tab-panel-1" aria-labelledby="tab-1">
                <form id="psr-profile-form" class="psr-form" autocomplete="off">
                    <div class="psr-form-group">
                        <label class="psr-form-label">Feature Image</label>
                        <div class="psr-field-with-published">
                            <div class="feature-image-preview" data-trigger-id="profile">
                                <div class="add-new-file-box round" accept="image/*" data-file-picker="true"
                                    data-max-files="1" data-trigger-id="profile" data-preview-style="round"
                                    folder="admin-profile" access="{{user.access}}">
                                    <i class="fas fa-camera"></i>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="profile" name="profile">
                    </div>

                    <div class="psr-grid psr-grid-col-2 gap-2">
                        <div class="psr-form-group">
                            <label class="psr-form-label">First Name</label>
                            <input type="text" class="psr-form-input" id="firstName" name="firstName"
                                placeholder="Enter your first name">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Last Name</label>
                            <input type="text" class="psr-form-input" id="lastName" name="lastName"
                                placeholder="Enter your last name">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Email</label>
                            <input type="email" class="psr-form-input" id="email" name="email"
                                placeholder="Enter your email ID">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Mobile</label>
                            <input type="text" class="psr-form-input" id="mobile" name="mobile"
                                placeholder="Enter your mobile No.">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Designation</label>
                            <input type="text" class="psr-form-input" id="designation" name="designation"
                                placeholder="Enter your designation">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Address</label>
                            <input type="text" class="psr-form-input" id="address" name="address"
                                placeholder="Enter your address">
                        </div>
                    </div>
                    <div class="psr-form-group">
                        <label class="psr-form-label">About</label>
                        <textarea class="psr-form-input psr-form-textarea" type="editor" id="about" name="about"
                            data-tools="paragraph,header,list,link,table"></textarea>
                    </div>
                    <div class="psr-profile-actions">
                        <button type="submit" class="psr-btn psr-btn-primary" id="psr-save">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{#section 'script'}}
<script>
    $('#psr-profile-form').psrValidate({
        rules: {
            firstName: { required: true, minLength: 2 },
            lastName: { required: true, minLength: 2 },
            email: { required: true, email: true },
            mobile: { required: true, phone: true },
            designation: { required: true },
            address: { required: true },
            about: { richRequired: true, richMinWords: 10 },
            profile: { required: false }
        },
        messages: {
            firstName: { required: 'Please enter your first name', minLength: 'First Name should be more then 2 characters' },
            lastName: { required: 'Please enter your last name', minLength: 'Last Name should be more then 2 characters' },
            email: { required: 'Email is required', email: 'Enter a valid email' },
            mobile: { required: 'Mobile is required', phone: 'Enter a valid mobile number' },
            designation: { required: 'Designation is required' },
            address: { required: 'Please enter your address' },
            about: { richRequired: 'Please provide your details', richMinWords: 'Please enter at least 10 words' },
            profile: { required: 'Please select profile image' }
        },
        beforeSubmit: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', true);
            if (!$btn.find('.psr-spinner').length) {
                $btn.prepend('<span class="psr-spinner"></span> ');
            }
        },
        onValid: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $.ajax({
                url: api(`admin-auth/register`),   // change this
                method: 'POST',
                data: $form.serialize(),
                success: function (res) {
                    $form[0].reset();
                    toastr.success('Form submitted successfully!');
                    $form.find('.success, .error').removeClass('success error');
                    $form.find('.psr-field-error').remove();
                },
                error: function (err) {
                    toastr.error('An error occurred while submiting.' + err.message);
                },
                complete: function () {
                    // 🔹 always reset button
                    $btn.prop('disabled', false);
                    $btn.find('.psr-spinner').remove();
                }
            });

            return false;
        },
        onInvalid: function () {
            toastr.error('Please correct the errors in the form.');
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', false);
            $btn.find('.psr-spinner').remove();
        }
    });
</script>
{{/section}}