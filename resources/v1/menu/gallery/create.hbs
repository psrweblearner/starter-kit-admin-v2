<div class="psr-card">
    <div class="psr-card-header">
        <h3 class="psr-card-title">Add New Gallery File</h3>
    </div>
    <div class="psr-card-body">
        <div class="psr-tabs" data-psr-tabs>
            <div class="psr-tablist" role="tablist" aria-label="Sample Tabs">
                <button role="tab" class="psr-tab active" aria-selected="true" aria-controls="tab-panel-1"
                    id="tab-1">Home</button>
            </div>
            <div tabindex="0" role="tabpanel" class="psr-tab-panel active" id="tab-panel-1" aria-labelledby="tab-1">
                <form id="psr-module-form" class="psr-form" autocomplete="off">
                  <div class="psr-form-group">
                        <label class="psr-form-label">Gallery Item (Image or Video) *</label>
                        <div class="psr-field-with-published">
                            <div class="feature-image-preview" data-trigger-id="gallery-file-id">
                                <div class="add-new-file-box rectangle" accept="*" data-file-picker="true" data-max-files="1" data-trigger-id="gallery-file-id" data-preview-style="rectangle"  access="{{user.access}}">
                                    <i class="fas fa-camera"></i>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="gallery-file-id" name="file_id">
                    </div>

                    <div class="psr-grid psr-grid-col-2 gap-2">
                        <div class="psr-form-group">
                            <label class="psr-form-label">Captions</label>
                            <input type="text" class="psr-form-input" id="title" name="title"
                                placeholder="Enter title">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Permalink</label>
                            <input type="text" class="psr-form-input" id="slug" name="slug"
                                placeholder="Enter Permalink">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Image Alt Text</label>
                            <input type="text" class="psr-form-input" id="alt" name="alt"
                                placeholder="Enter image alt text">
                        </div>
                    </div>
                    <div class="psr-form-group">
                        <label class="psr-form-label">Tagline</label>
                        <div class="psr-field-with-published">
                            <textarea class="psr-form-input psr-form-textarea" id="description" name="description" rows="2"
                                placeholder="Tagline"></textarea>
                        </div>
                    </div>
                    

                    <div class="psr-profile-actions">
                        <button type="submit" class="psr-btn psr-btn-primary" id="psr-save">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{#section 'script'}}
<script>
    $('#psr-module-form').psrValidate({
        rules: {
            title: { required: true, minLength: 2 },
            slug: { required: false, minLength: 2 },
            alt: { required: true},
            description: { required: false },
            file_id: { required: true }
        },
        messages: {
            title: { required: 'Please enter title', minLength: 'Title should be more then 2 characters' },
            slug: { required: 'Please enter slug', minLength: 'Slug should be more then 2 characters' },
            alt: { required: 'Image alt text is required'},
        },
        beforeSubmit: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', true);
            if (!$btn.find('.psr-spinner').length) {
                $btn.prepend('<span class="psr-spinner"></span> ');
            }
        },
        onValid: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $.ajax({
                url: api(`gallery`),   // change this
                method: 'POST',
                data: $form.serialize(),
                success: function (res) {
                    $form[0].reset();
                    toastr.success('Form submitted successfully!');
                    $form.find('.success, .error').removeClass('success error');
                    $form.find('.psr-field-error').remove();
                },
                error: function (err) {
                    toastr.error('An error occurred while submiting.' + err.message);
                },
                complete: function () {
                    // 🔹 always reset button
                    $btn.prop('disabled', false);
                    $btn.find('.psr-spinner').remove();
                }
            });

            return false;
        },
        onInvalid: function () {
            toastr.error('Please correct the errors in the form.');
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', false);
            $btn.find('.psr-spinner').remove();
        }
    });
</script>
{{/section}}