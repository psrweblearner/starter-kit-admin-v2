<div class="psr-card">
    <div class="psr-card-header">
        <h3 class="psr-card-title">Add New Module</h3>
    </div>
    <div class="psr-card-body">
        <div class="psr-tabs" data-psr-tabs>
            <div class="psr-tablist" role="tablist" aria-label="Sample Tabs">
                <button role="tab" class="psr-tab active" aria-selected="true" aria-controls="tab-panel-1"
                    id="tab-1">Home</button>
            </div>
            <div tabindex="0" role="tabpanel" class="psr-tab-panel active" id="tab-panel-1" aria-labelledby="tab-1">
                <form id="psr-settings-form" class="psr-form" autocomplete="off">
                    <div class="psr-grid psr-grid-col-2 gap-2">
                        <div class="psr-form-group">
                            <label class="psr-form-label">Title</label>
                            <input type="text" class="psr-form-input" id="title" name="title" placeholder="Enter title">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Value</label>
                            <input type="text" class="psr-form-input" id="value" name="value" placeholder="Enter value">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Type</label>
                            <input type="text" class="psr-form-input" id="type" name="type" placeholder="Enter Type">
                        </div>
                    </div>

                    <div class="psr-profile-actions">
                        <button type="submit" class="psr-btn psr-btn-primary" id="psr-save">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{#section 'script'}}
<script>
    $('#psr-settings-form').psrValidate({
        rules: {
            title: { required: true, minLength: 2 },
            value: { required: true, minLength: 2 },
            type: { required: true },
        },
        messages: {
            title: { required: 'Please enter title', minLength: 'Title should be more then 2 characters' },
            value: { required: 'Please enter value', minLength: 'value should be more then 2 characters' },
            type: { required: 'Type is required' },
        },
        beforeSubmit: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', true);
            if (!$btn.find('.psr-spinner').length) {
                $btn.prepend('<span class="psr-spinner"></span> ');
            }
        },
        onValid: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $.ajax({
                url: api(`settings`),   // change this
                method: 'POST',
                data: $form.serialize(),
                success: function (res) {
                    $form[0].reset();
                    toastr.success('Form submitted successfully!');
                    $form.find('.success, .error').removeClass('success error');
                    $form.find('.psr-field-error').remove();
                },
                error: function (err) {
                    toastr.error('An error occurred while submiting.' + err.message);
                },
                complete: function () {
                    // 🔹 always reset button
                    $btn.prop('disabled', false);
                    $btn.find('.psr-spinner').remove();
                }
            });

            return false;
        },
        onInvalid: function () {
            toastr.error('Please correct the errors in the form.');
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', false);
            $btn.find('.psr-spinner').remove();
        }
    });
</script>
{{/section}}