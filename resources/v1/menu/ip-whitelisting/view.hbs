<div class="psr-card psr-card-compact">
    <div class="psr-card-header">
        <h5 class="psr-card-title">
            {{#if (canAccess 'create')}}
            <button class="psr-btn psr-btn-primary psr-btn-icon" title="Add New IP"
                onclick="window.location.href='/admin/{{category}}/{{menu}}/create'">
                <i class="fa-solid fa-plus"></i>
            </button>
            {{/if}}
        </h5>
    </div>

    <div class="psr-card-body">
        <table id="properties-table" class="psr-table" data-api="api-client" data-filter="true" data-filter-fields="*"
            data-actions="true" data-blur-field="api_key" data-default-field="name,domain,api_key"
            data-toggle-field="allow_all,status" data-access="{{user.access}}">
        </table>
    </div>
</div>

{{#section 'script'}}
<script>
    PSRDataTable.setHandlers({
        edit: function (id, rowData, tableInstance) {
            window.location.href = `/admin/{{category}}/{{menu}}/${id}`
        },

        delete: async function (id, rowData, tableInstance) {
            const result = await Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(api(`api-client/${id}`), {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (response.ok) {
                        Swal.fire('Deleted!', 'Client has been deleted.', 'success');
                        tableInstance.reloadData();
                    } else {
                        const errorData = await response.json();
                        Swal.fire('Failed!', `Failed to delete client: ${errorData.message || response.statusText}`, 'error');
                    }
                } catch (error) {
                    Swal.fire('Error!', `Error deleting client: ${error.message}`, 'error');
                }
            }
        },

        toggle: async function (id, field, newValue, rowData, tableInstance) {
            try {
                const response = await fetch(api(`api-client/${id}`), {
                    method: 'PATCH', // Assuming PATCH is used for simple updates
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ [field]: newValue })
                });

                if (response.ok) {
                    Swal.fire(
                        'Updated!',
                        'Client status updated successfully.',
                        'success'
                    );
                    tableInstance.reloadData();
                } else {
                    const errorData = await response.json();
                    Swal.fire(
                        'Failed!',
                        `Failed to update: ${errorData.message || response.statusText}`,
                        'error'
                    );
                }
            } catch (error) {
                Swal.fire(
                    'Error!',
                    `Error updating: ${error.message}`,
                    'error'
                );
            }
        }
    });

    // Global toggle logic placeholder
    document.getElementById('global-allow-everyone-toggle')?.addEventListener('change', function (e) {
        const isChecked = e.target.checked;
        toastr.info('Global Allow Everyone: ' + (isChecked ? 'Enabled' : 'Disabled'));
        // Implementation for global toggle would go here if an API exists
    });
</script>
{{/section}}