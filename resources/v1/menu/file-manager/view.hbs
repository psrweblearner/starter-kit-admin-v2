<div class="file-manager-container">
    <!-- Toolbar -->
    <div class="toolbar">
        <div class="breadcrumb" id="breadcrumb">
            <span class="breadcrumb-item" onclick="fileManager.goToRoot()">Root</span>
        </div>
        <div class="storage-indicator" id="storageIndicator">
            <i class="fas fa-hdd"></i>
            <span>Loading...</span>
        </div>
        {{#eqIf user.role.title 'Admin'}}
        <div class="sync-section">
            <button class="sync-btn" id="syncBtn" onclick="fileManager.syncStorage()" title="Sync database with storage">
            <i class="fas fa-sync-alt" id="syncIcon"></i>
            <span>Sync</span>
            </button>
        </div>
        {{/eqIf}}

        <div class="toolbar-actions">
            <!-- Search Bar -->
            <div class="search-container">
                <div class="search-input-wrapper">
                    <input type="text" id="searchInput" placeholder="Search files and folders..." class="search-input"
                        oninput="fileManager.handleSearchInput(event)"
                        onkeydown="fileManager.handleSearchKeydown(event)">

                    <button class="search-clear-btn" id="searchClearBtn" onclick="fileManager.clearSearch()"
                        style="display: none;">
                        <i class="fas fa-times"></i>
                    </button>

                    <button class="search-btn" onclick="fileManager.toggleAdvancedFilters()" id="filterToggleBtn"
                        title="Toggle Advanced Filters">
                        <i class="fas fa-filter" id="filterIcon"></i>
                    </button>

                    <button class="search-btn" onclick="fileManager.triggerSearch()" id="searchBtn">
                        <i class="fas fa-search" id="searchIcon"></i>
                        <i class="fas fa-spinner fa-spin" id="searchSpinner" style="display: none;"></i>
                    </button>
                </div>

                <div class="search-filters" id="searchFilters" style="display: none;">
                    <div class="filter-group">
                        <label class="filter-label">File Type</label>
                        <select class="filter-select" id="fileTypeFilter" onchange="fileManager.handleFilterChange()">
                            <option value="all">All Items</option>
                            <option value="files">Files Only</option>
                            <option value="folders">Folders Only</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Search Scope</label>
                        <div class="filter-toggle" id="folderScopeToggle" onclick="fileManager.toggleFolderScope()">
                            <input type="checkbox" id="folderScopeCheckbox">
                            <span>Current Folder Only</span>
                        </div>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">Search Mode</label>
                        <div class="filter-toggle" id="exactMatchToggle" onclick="fileManager.toggleExactMatch()">
                            <input type="checkbox" id="exactMatchCheckbox">
                            <span>Exact Match</span>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="psr-btn psr-btn-secondary psr-btn-icon" onclick="fileManager.goBack()" id="backBtn"
                    title="Go Back">
                    <i class="fa fa-arrow-left"></i>
                </button>
                
                <button class="psr-btn psr-btn-primary psr-btn-icon" onclick="fileManager.downloadSelectedFiles()"
                    id="downloadSelectedBtn" disabled title="Download Selected">
                    <i class="fa-solid fa-download"></i>
                </button>
                <button class="psr-btn psr-btn-primary psr-btn-icon" onclick="fileManager.deleteSelectedFiles()"
                    id="deleteSelectedBtn" disabled title="Delete Selected">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Content Area -->
    <div class="content-area">
        <!-- Loading State -->
        <div class="loading-state" id="loadingState" style="display: none;">
            <div class="loading-spinner"></div>
            <p id="loadingText">Loading files...</p>
        </div>

        <!-- File Grid -->
        <div class="file-grid" id="fileGrid">
            <!-- Files will be loaded here -->
        </div>

        <!-- Pagination Controls -->
        <div class="pagination-controls" id="paginationControls" style="display: none;">
            <!-- Dynamic pagination controls will be inserted here -->
        </div>

        <!-- Empty State -->
        <div class="empty-state" id="emptyState" style="display: none;">
            <i class="fas fa-folder-open"></i>
            <h3>No files in this folder</h3>
            <p>Upload some files to get started</p>
        </div>
    </div>
</div>

<!-- Create Folder Modal -->
    <div class="psr-modal-overlay" id="createFolderModal">
        <div class="psr-modal compact-modal">
            <div class="psr-modal-header">
                <div class="modal-title-section">
                    <div class="modal-icon">
                        <i class="fas fa-folder-plus"></i>
            </div>
                    <div class="modal-title-content">
                        <h3 class="psr-modal-title">Create New Folder</h3>
                        <div class="location-in-header">
                            <i class="fas fa-map-marker-alt"></i>
