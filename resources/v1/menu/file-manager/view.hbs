                        </div>
                    </div>
                    <div class="input-hint">Use letters, numbers, spaces, hyphens, and underscores only</div>
                </div>
            </div>
            <div class="psr-modal-footer">
                <button class="psr-btn psr-btn-secondary" onclick="fileManager.hideCreateFolderDialog()">
                    <i class="fas fa-times"></i>
                    Cancel
                </button>
                <button class="psr-btn psr-btn-success" onclick="fileManager.createNewFolder()">
                    <i class="fas fa-plus"></i>
                    Create Folder
                </button>
            </div>
        </div>
    </div>

<!-- Upload Files Modal -->
<div class="psr-modal-overlay" id="uploadFilesModal">
    <div class="psr-modal upload-modal">
        <div class="psr-modal-header">
            <div class="modal-title-section">
                <div class="modal-icon">
                    <i class="fas fa-cloud-upload-alt"></i>
                </div>
                <div class="modal-title-content">
                    <h3 class="psr-modal-title">Upload Files</h3>
                    <p class="modal-subtitle">Select files to upload to your current folder</p>
                    <div class="location-in-header">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Upload to:</span>
                        <span class="location-path" id="uploadFolderPath">Root</span>
                    </div>
                </div>
            </div>
            <button class="psr-modal-close" onclick="fileManager.hideUploadModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="psr-modal-body">
            
            <!-- Upload Area -->
            <div class="upload-area" id="uploadArea">
                <div class="upload-content">
                    <div class="upload-icon">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <div class="upload-text">
                        <h4>Drag & Drop Files Here</h4>
                        <p>or click to browse files</p>
                    </div>
                    <div class="upload-hint">
                        <span>Supports: Images, Documents, Videos, Archives</span>
                        <span>Max size: 50MB per file</span>
                    </div>
                </div>
                <input type="file" id="fileInput" multiple accept="*/*" style="display: none;">
            </div>

            <!-- File List -->
            <div class="file-list" id="fileList" style="display: none;">
                <div class="file-list-header">
                    <h4>Selected Files</h4>
                    <button class="clear-files-btn" onclick="fileManager.clearFileList()">
                        <i class="fas fa-trash"></i>
                        Clear All
                    </button>
                </div>
                <div class="file-items" id="fileItems"></div>
            </div>

            <!-- Upload Progress -->
            <div class="upload-progress" id="uploadProgress" style="display: none;">
                <div class="progress-header">
                    <span>Uploading files...</span>
                    <span class="progress-percentage" id="progressPercentage">0%</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <div class="progress-details" id="progressDetails"></div>
            </div>
        </div>
        <div class="psr-modal-footer">
            <button class="psr-btn psr-btn-secondary" onclick="fileManager.hideUploadModal()">
                <i class="fas fa-times"></i>
                Cancel
            </button>
            <button class="psr-btn psr-btn-primary" id="uploadBtn" onclick="fileManager.uploadFiles()" disabled>
                <i class="fas fa-upload"></i>
                Upload Files
            </button>
        </div>
    </div>
</div>

<!-- File Preview Modal -->
<div class="psr-modal-overlay" id="filePreviewModal">
    <div class="psr-modal preview-modal">
            <div class="psr-modal-header">
                <div class="modal-title-section">
                    <div class="modal-icon">
                        <i class="fas fa-file"></i>
                    </div>
                    <div class="modal-title-content">
                        <h3 class="psr-modal-title" id="previewFileName">File Preview</h3>
                    </div>
                </div>
                <button class="psr-modal-close" onclick="fileManager.closePreviewModal()" aria-label="Close preview">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        <div class="psr-modal-body">
            <div class="preview-content" id="previewContainer">
                <!-- Preview content will be inserted here -->
            </div>
                {{#if (canAccess 'download')}}
            <div class="preview-controls">
                <button onclick="fileManager.downloadCurrentFile()" title="Download">
                    <i class="fas fa-download"></i>
                </button>
            </div>
                {{/if}}
        </div>
        
    </div>
</div>

{{#section 'script'}}

<script src="/admin/js/fileManager.js"></script>
{{/section}}