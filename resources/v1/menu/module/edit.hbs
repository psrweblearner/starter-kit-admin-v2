<div class="psr-card">
    <div class="psr-card-header">
        <h3 class="psr-card-title"><i class="{{data.icon}}"></i> {{data.title}} - Module</h3>
    </div>
    <div class="psr-card-body">
        <div class="psr-tabs" data-psr-tabs>
            <div class="psr-tablist" role="tablist" aria-label="Sample Tabs">
                <button role="tab" class="psr-tab active" aria-selected="true" aria-controls="tab-panel-1"
                    id="tab-1">Home</button>
            </div>
            <div tabindex="0" role="tabpanel" class="psr-tab-panel active" id="tab-panel-1" aria-labelledby="tab-1">
                <form id="psr-module-form" class="psr-form" autocomplete="off">
                    <!-- Feature Image Section -->
                    <div class="psr-form-group">
                    <label class="psr-form-label">Module Image</label>
                    <div class="feature-image-preview" data-trigger-id="image">
                        {{#if data.image}}
                        <div class="preview-thumb-wrapper round">
                            <img src="{{data.image.file}}" class="preview-media round">
                            <button type="button" class="remove-preview-btn"><i class="fas fa-times"></i></button>
                        </div>
                        {{/if}}
                        <div class="add-new-file-box round" data-file-picker="true" data-max-files="1" data-trigger-id="image" data-preview-style="round" folder="module" access="{{user.access}}" accept="image/*" style="{{#if data.image}}display:none;{{/if}}">
                        <i class="fas fa-camera"></i>
                        </div>
                    </div>
                    <input type="hidden" id="image" name="image" value="{{data.image.id}}" class="{{#if data.image}}success{{/if}}">
                    </div>

                    <div class="psr-grid psr-grid-col-2 gap-2">
                       
                        <div class="psr-form-group">
                            <label class="psr-form-label">Title</label>
                            <input type="text" class="psr-form-input" id="title" name="title"
                                placeholder="Enter title" value="{{data.title}}">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Slug</label>
                            <input type="text" class="psr-form-input" id="slug" name="slug"
                                placeholder="Enter slug" value="{{data.slug}}">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Icon <small>(fa-solid fa-users)</small></label>
                            <input type="text" class="psr-form-input" id="icon" name="icon"
                                placeholder="Enter icon class" value="{{data.icon}}">
                        </div>
                    </div>

                    <div class="psr-profile-actions">
                        <button type="submit" class="psr-btn psr-btn-primary" id="psr-save">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{#section 'script'}}
<script>
    $('#psr-module-form').psrValidate({
        rules: {
            title: { required: true, minLength: 2 },
            slug: { required: true, minLength: 2 },
            icon: { required: true},
            image: { required: false }
        },
        messages: {
            title: { required: 'Please enter title', minLength: 'Title should be more then 2 characters' },
            slug: { required: 'Please enter slug', minLength: 'Slug should be more then 2 characters' },
            icon: { required: 'Icon is required'},
        },
        beforeSubmit: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', true);
            if (!$btn.find('.psr-spinner').length) {
                $btn.prepend('<span class="psr-spinner"></span> ');
            }
        },
        onValid: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $.ajax({
                url: api(`menu/{{data.id}}`),   // change this
                method: 'PUT',
                data: $form.serialize(),
                success: function (res) {
                    toastr.success('Form submitted successfully!');
                    $form.find('.success, .error').removeClass('success error');
                    $form.find('.psr-field-error').remove();
                },
                error: function (err) {
                    toastr.error('An error occurred while submiting.' + err.message);
                },
                complete: function () {
                    // 🔹 always reset button
                    $btn.prop('disabled', false);
                    $btn.find('.psr-spinner').remove();
                }
            });

            return false;
        },
        onInvalid: function () {
            toastr.error('Please correct the errors in the form.');
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', false);
            $btn.find('.psr-spinner').remove();
        }
    });
</script>
{{/section}}