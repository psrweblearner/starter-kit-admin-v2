<div class="psr-card">
    <div class="psr-card-header">
        <h3 class="psr-card-title">Add New Floor Plan</h3>
    </div>
    <div class="psr-card-body">
        <div class="psr-tabs" data-psr-tabs>
            <div class="psr-tablist" role="tablist" aria-label="Sample Tabs">
                <button role="tab" class="psr-tab active" aria-selected="true" aria-controls="tab-panel-1"
                    id="tab-1">Home</button>
            </div>
            <div tabindex="0" role="tabpanel" class="psr-tab-panel active" id="tab-panel-1" aria-labelledby="tab-1">
                <form id="psr-floor-plan-form" class="psr-form" autocomplete="off">
                  <div class="psr-form-group">
                        <label class="psr-form-label">Floor Plan Image</label>
                        <div class="psr-field-with-published">
                            <div class="feature-image-preview" data-trigger-id="floor_plan_img">
                                <div class="add-new-file-box round" accept="image/*" data-file-picker="true" data-max-files="1" data-trigger-id="floor_plan_img" data-preview-style="round" folder="floor-plan" access="{{user.access}}">
                                    <i class="fas fa-camera"></i>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" id="floor_plan_img" name="file_id">
                    </div>

                    <div class="psr-grid psr-grid-col-2 gap-2">
                        <div class="psr-form-group">
                            <label class="psr-form-label">Bedroom</label>
                            <input type="text" class="psr-form-input" id="bedroom" name="bedroom"
                                placeholder="Enter Bedroom">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Bathroom</label>
                            <input type="text" class="psr-form-input" id="bathroom" name="bathroom"
                                placeholder="Enter Bathroom">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Amount</label>
                            <input type="text" class="psr-form-input" id="amount" name="amount"
                                placeholder="Enter Amount">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Area</label>
                            <input type="text" class="psr-form-input" id="area" name="area"
                                placeholder="Enter Area">
                        </div>
                        <div class="psr-form-group">
                            <label class="psr-form-label">Parking</label>
                            <input type="text" class="psr-form-input" id="parking" name="parking"
                                placeholder="Enter Parking">
                        </div>
                    </div>
                    <div class="psr-form-group">
                        <label class="psr-form-label">Tagline</label>
                        <textarea class="psr-form-input psr-form-textarea" id="tagline" name="tagline"></textarea>
                    </div>
                    <div class="psr-profile-actions">
                        <button type="submit" class="psr-btn psr-btn-primary" id="psr-save">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{{#section 'script'}}
<script>
    $('#psr-floor-plan-form').psrValidate({
        rules: {
            bedroom: { required: true },
            bathroom: { required: true },
            amount: { required: true},
            area: { required: true },
            parking: { required: true },
            tagline:{required:true},
            file_id:{required:true}
        },
        messages: {
            bedroom: { required: 'Bedroom is required' },
            bathroom: { required: 'Bathroom is required' },
            amount: { required: 'Amount is required'},
            area: { required: 'Area is required'},
            parking: { required: 'Parking is required'},
            tagline:{required:'Tagline is required'},
            file_id:{required:'Image is required'}
        },
        beforeSubmit: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', true);
            if (!$btn.find('.psr-spinner').length) {
                $btn.prepend('<span class="psr-spinner"></span> ');
            }
        },
        onValid: function () {
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $.ajax({
                url: api(`floor-plan`),   // change this
                method: 'POST',
                data: $form.serialize(),
                success: function (res) {
                    $form[0].reset();
                    toastr.success('Form submitted successfully!');
                    $form.find('.success, .error').removeClass('success error');
                    $form.find('.psr-field-error').remove();
                },
                error: function (err) {
                    toastr.error('An error occurred while submiting.' + err.message);
                },
                complete: function () {
                    // 🔹 always reset button
                    $btn.prop('disabled', false);
                    $btn.find('.psr-spinner').remove();
                }
            });

            return false;
        },
        onInvalid: function () {
            toastr.error('Please correct the errors in the form.');
            var $form = $(this);
            var $btn = $form.find('button[type=submit]');
            $btn.prop('disabled', false);
            $btn.find('.psr-spinner').remove();
        }
    });
</script>
{{/section}}