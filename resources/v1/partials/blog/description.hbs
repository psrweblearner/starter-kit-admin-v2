<form id="blogDesc" class="psr-form" autocomplete="off">
    <div class="psr-form-group">
        <label class="psr-form-label">Description *</label>
        <div class="psr-field-with-published">
            <textarea class="psr-form-input psr-form-textarea" type="editor" accept="*" id="description"
                name="description" rows="3" placeholder="description"
                data-tools="paragraph,header,list,image,video,link,table">{{{data.description}}}</textarea>
        </div>
    </div>
    <div class="psr-form-actions">
        <button type="submit" class="psr-btn psr-btn-primary">
            <i class="fa-solid fa-save"></i> Update Description
        </button>
    </div>
</form>