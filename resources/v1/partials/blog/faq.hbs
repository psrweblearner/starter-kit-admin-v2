<form id="blogFaq" class="psr-form" autocomplete="off">
    <div class="psr-grid psr-grid-col-2 gap-2">
        <div class="psr-form-group">
            <label class="psr-form-label">Faqs *</label>
            <div class="psr-field-with-published">
                <select class="psr-form-input" id="faq" name="faqs" multiple data-url="faq" data-root="data"
                    data-value-field="id" data-label-field="question" data-selected='{{ pluck data.faqs "id" }}' data-description-field="cateory"
                    data-placeholder="Select Faqs">
                </select>
            </div>
        </div>
    </div>
    <div class="psr-form-actions">
        <button type="submit" class="psr-btn psr-btn-primary">
            <i class="fa-solid fa-save"></i> Add to Faq
        </button>
    </div>
</form>

<div class="psr-card-body">
    <table id="blog-faq-table" class="psr-basic-datatable" selected-data="{{json data.faqs}}" data-filter="true"
        data-actions="false" data-default-field="question,ans" data-page-size="5" data-sticky-header="true">
    </table>
</div>