    <script>

        function displayTime() {
            var date = new Date();
            var hours = date.getHours();
            var minutes = date.getMinutes();
            var seconds = date.getSeconds();
            var ampm = hours >= 12 ? 'pm' : 'am';
            hours = hours % 12;
            hours = hours ? hours : 12; // the hour '0' should be '12'
            minutes = minutes < 10 ? '0' + minutes : minutes;
            seconds = seconds < 10 ? '0' + seconds : seconds;
            var time = hours + ':' + minutes + ':' + seconds + ' ' + ampm;
            document.getElementById('time').innerHTML = time;

            var greeting;
            if (hours >= 5 && hours < 12 && ampm === 'am') {
                greeting = 'Good morning,';
            }
            else if (hours === 12 && ampm === 'pm') {
                greeting = 'Good afternoon,';
            }
            else if (hours >= 1 && hours < 4 && ampm === 'pm') {
                greeting = 'Good afternoon,';
            }
            else if (hours >= 4 && hours < 8 && ampm === 'pm') {
                greeting = 'Good evening,';
            } else {
                greeting = 'Good night,';
            }
            document.getElementById('greeting').innerHTML = greeting;

            setTimeout(displayTime, 1000);
        }

        function toggleRoleDropdown(event) {
            event.stopPropagation(); // prevent closing immediately
            const dropdown = document.getElementById('psrRoleDropdown');
            dropdown.classList.toggle('hidden');
        }

        function toggleProfileDropdown(event) {
            event.stopPropagation(); // prevent closing immediately
            const dropdown = document.getElementById('psrProfileDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Optional: click outside to close
        document.addEventListener('click', function () {
            const roleDropdown = document.getElementById('psrRoleDropdown');
            const profileDropdown = document.getElementById('psrProfileDropdown');
            if (roleDropdown && !roleDropdown.classList.contains('hidden')) {
                roleDropdown.classList.add('hidden');
            }
            if (profileDropdown && !profileDropdown.classList.contains('hidden')) {
                profileDropdown.classList.add('hidden');
            }
        });




        function switchRole(roleId, userId) {
            roleId = Number(roleId);
            userId = Number(userId);

            fetchData(api('admin-auth/switch-role'), {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: { roleId, userId }
            }).then(response => {
                if (response.success) {
                    // Bridge removed - Nginx handles cookie propagation
                    location.reload();
                } else {
                    toastr.error(response.message || 'Failed to switch role');
                }
            }).catch(err => {
                console.error('Error switching role:', err);
                toastr.error('An error occurred while switching role');
            });
        }
    </script>
