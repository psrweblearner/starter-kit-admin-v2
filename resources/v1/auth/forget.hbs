<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    
</head>

<body
    class="bg-gray-900 font-sans antialiased text-gray-100 bg-gradient-to-br from-gray-900 to-black h-screen selection:bg-blue-500 selection:text-white">

    <div class="min-h-screen flex items-center justify-center relative overflow-hidden p-4">

        <!-- Background Elements -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
            <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-blue-600/10 rounded-full blur-[120px]"></div>
            <div class="absolute top-[20%] right-[10%] w-[40%] h-[40%] bg-indigo-600/10 rounded-full blur-[100px]">
            </div>
        </div>

        <div
            class="bg-gray-800/60 backdrop-blur-xl shadow-2xl rounded-2xl w-full max-w-md p-8 border border-gray-700/50 relative z-10 transition-all duration-300 hover:shadow-blue-500/10 hover:border-gray-600">

            <div class="flex justify-center mb-6">
                <div
                    class="w-20 h-20 bg-gradient-to-tr from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg transform rotate-3 hover:rotate-0 transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                </div>
            </div>

            <h2 id="pageTitle" class="text-3xl font-extrabold text-center text-white mb-2 tracking-tight">Forgot
                Password</h2>
            <p id="pageDesc" class="text-center text-gray-400 mb-8 text-sm">Enter your email or mobile to receive an OTP</p>

            <!-- Success message for OTP -->
            <div id="successBanner"
                class="hidden mb-6 bg-green-500/10 border border-green-500/20 text-green-400 p-3 rounded-xl text-center text-sm animate-fade-in">
                OTP has been sent to your registered email or mobile number.
            </div>

            <!-- STEP 1: Identify -->
            <form id="stepIdentify" class="space-y-6">
                <div class="space-y-1">
                    <label for="username" class="block text-sm font-medium text-gray-300 ml-1">Email or Mobile</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-500">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                            </svg>
                        </div>
                        <input type="text" id="username" name="username" autocomplete="username" required placeholder="Enter Email or Mobile"
                            class="w-full pl-10 pr-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500"
                            >
                    </div>
                </div>
                <button type="submit"
                    class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-blue-600/20 hover:shadow-blue-600/40 transform hover:-translate-y-0.5 transition-all duration-200">
                    Send OTP
                </button>
            </form>

            <!-- STEP 2: Verify OTP (Hidden by default) -->
            <form id="stepVerify" class="hidden space-y-6">
                <div class="space-y-1">
                    <label for="otp" class="block text-sm font-medium text-gray-300 ml-1">Enter OTP</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-500">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <input type="text" id="otp" placeholder="Enter 6-digit OTP" maxlength="6"
                            class="w-full pl-10 pr-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500 tracking-widest text-center text-xl font-bold"
                            required>
                    </div>
                </div>
                <button type="submit"
                    class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-blue-600/20 hover:shadow-blue-600/40 transform hover:-translate-y-0.5 transition-all duration-200">
                    Verify OTP
                </button>
                <div class="text-center">
                    <button type="button" id="resendOtp"
                        class="text-sm text-blue-400 hover:text-blue-300 transition-colors">Resend OTP</button>
                </div>
            </form>

            <!-- STEP 3: Reset Password (Hidden by default) -->
            <form id="stepReset" class="hidden space-y-4">
                <div class="space-y-1">
                    <label for="newPassword" class="block text-sm font-medium text-gray-300 ml-1">New Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-500">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </div>
                        <input type="password" id="newPassword" placeholder="••••••••"
                            class="w-full pl-10 pr-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500"
                            required>
                    </div>
                    <!-- Password Strength indicator -->
                    <div id="pwStrength" class="flex gap-1 mt-2 px-1">
                        <div class="h-1 flex-1 bg-gray-700 rounded-full transition-all"></div>
                        <div class="h-1 flex-1 bg-gray-700 rounded-full transition-all"></div>
                        <div class="h-1 flex-1 bg-gray-700 rounded-full transition-all"></div>
                        <div class="h-1 flex-1 bg-gray-700 rounded-full transition-all"></div>
                    </div>
                    <ul id="pwRequirements" class="text-[10px] text-gray-500 mt-2 space-y-1 ml-1 grid grid-cols-2">
                        <li id="reqLength" class="flex items-center gap-1">
                            <div class="w-1 h-1 rounded-full bg-gray-500"></div> Min 8 chars
                        </li>
                        <li id="reqUpper" class="flex items-center gap-1">
                            <div class="w-1 h-1 rounded-full bg-gray-500"></div> One Uppercase
                        </li>
                        <li id="reqNumber" class="flex items-center gap-1">
                            <div class="w-1 h-1 rounded-full bg-gray-500"></div> One Number
                        </li>
                        <li id="reqSpecial" class="flex items-center gap-1">
                            <div class="w-1 h-1 rounded-full bg-gray-500"></div> Special Char
                        </li>
                    </ul>
                </div>

                <div class="space-y-1">
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-300 ml-1">Confirm
                        Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-500">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </div>
                        <input type="password" id="confirmPassword" placeholder="••••••••"
                            class="w-full pl-10 pr-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500"
                            required>
                    </div>
                </div>

                <button type="submit" id="resetBtn" disabled
                    class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-blue-600/20 hover:shadow-blue-600/40 transform hover:-translate-y-0.5 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                    Reset Password
                </button>
            </form>

            <p id="errorMsg"
                class="mt-4 text-red-400 bg-red-400/10 border border-red-400/20 rounded-lg p-3 text-sm text-center hidden animate-pulse">
            </p>

            <div class="mt-8 text-center text-sm text-gray-500">
                <a href="/"
                    class="font-semibold text-blue-400 hover:text-blue-300 transition-colors flex items-center justify-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Login
                </a>
            </div>
        </div>
    </div>

    <script src="/helper.js"></script>
    <script src="/auth/forget.js"></script>
    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/919266535507?text=Hi%2C%20I%20want%20more%20details%20about%20your%20platform" target="_blank"
        class="fixed bottom-6 right-6 w-14 h-14 bg-green-500 text-white rounded-full flex items-center justify-center shadow-[0_0_15px_rgba(34,197,94,0.5)] hover:bg-green-600 hover:scale-110 transition-all duration-300 z-50">
        <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 animate-ping"></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 relative z-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.129.332.202.043.073.043.423-.101.827z" />
        </svg>
    </a>
</body>

</html>
