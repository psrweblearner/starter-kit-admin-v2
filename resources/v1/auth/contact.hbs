<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Access - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
   
</head>

<body
    class="bg-gray-900 font-sans antialiased text-gray-100 bg-gradient-to-br from-gray-900 to-black h-screen selection:bg-blue-500 selection:text-white">

    <div class="min-h-screen flex items-center justify-center relative overflow-hidden p-4">

        <!-- Background Elements -->
        <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
            <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-blue-600/10 rounded-full blur-[120px]"></div>
            <div class="absolute top-[20%] right-[10%] w-[40%] h-[40%] bg-indigo-600/10 rounded-full blur-[100px]">
            </div>
        </div>

        <div
            class="bg-gray-800/60 backdrop-blur-xl shadow-2xl rounded-2xl w-full max-w-lg p-8 border border-gray-700/50 relative z-10 transition-all duration-300 hover:shadow-blue-500/10 hover:border-gray-600">

            <div class="flex justify-center mb-6">
                <div
                    class="w-20 h-20 bg-gradient-to-tr from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg transform rotate-3 hover:rotate-0 transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                </div>
            </div>

            <h2 class="text-3xl font-extrabold text-center text-white mb-2 tracking-tight">Request Access</h2>
            <p class="text-center text-gray-400 mb-8 text-sm">Please provide your details to request an admin account.
            </p>

            <!-- Access Request Form -->
            <form id="contactForm" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label for="fullName" class="block text-sm font-medium text-gray-300 ml-1">Full Name</label>
                        <input type="text" id="fullName" name="fullName" placeholder="John Doe"
                            class="w-full px-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500"
                            required>
                    </div>
                    <div class="space-y-1">
                        <label for="workEmail" class="block text-sm font-medium text-gray-300 ml-1">Work Email</label>
                        <input type="email" id="workEmail" name="workEmail" placeholder="john@inchbrick.com"
                            class="w-full px-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500"
                            required>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label for="mobile" class="block text-sm font-medium text-gray-300 ml-1">Mobile Number</label>
                        <input type="tel" id="mobile" name="mobile" placeholder="+91 84474..."
                            class="w-full px-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500"
                            required>
                    </div>
                    <div class="space-y-1">
                        <label for="department" class="block text-sm font-medium text-gray-300 ml-1">Department</label>
                        <select id="department" name="department"
                            class="w-full px-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100">
                            <option value="" disabled selected>Select Field</option>
                            <option value="IT">IT / Systems</option>
                            <option value="Operations">Operations</option>
                            <option value="Sales">Sales</option>
                            <option value="HR">HR / Admin</option>
                            <option value="Accounts">Accounts</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-1">
                    <label for="reason" class="block text-sm font-medium text-gray-300 ml-1">Why do you need
                        access?</label>
                    <textarea id="reason" name="reason" rows="3" placeholder="Identify your work profile and purpose..."
                        class="w-full px-4 py-3 bg-gray-900/50 border border-gray-600 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition-all duration-200 text-gray-100 placeholder-gray-500 resize-none"
                        required></textarea>
                </div>

                <div id="statusMsg" class="hidden text-sm p-3 rounded-xl text-center animate-fade-in"></div>

                <button type="submit" id="submitBtn"
                    class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-blue-600/20 hover:shadow-blue-600/40 transform hover:-translate-y-0.5 transition-all duration-200">
                    Send Request
                </button>
            </form>

            <div class="mt-8 text-center text-sm text-gray-500">
                <a href="/"
                    class="font-semibold text-blue-400 hover:text-blue-300 transition-colors flex items-center justify-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Login
                </a>
            </div>
        </div>
    </div>

    <script src="/helper.js"></script>
    <script src="/auth/contact.js"></script>
    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/919266535507?text=Hi%2C%20I%20want%20more%20details%20about%20your%20platform" target="_blank"
        class="fixed bottom-6 right-6 w-14 h-14 bg-green-500 text-white rounded-full flex items-center justify-center shadow-[0_0_15px_rgba(34,197,94,0.5)] hover:bg-green-600 hover:scale-110 transition-all duration-300 z-50">
        <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 animate-ping"></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 relative z-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.129.332.202.043.073.043.423-.101.827z" />
        </svg>
    </a>
</body>

</html>